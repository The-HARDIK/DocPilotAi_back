# ==========================================
# DocPilot AI - Environment Configuration Template
# ==========================================

# Google Gemini API Key (Required for LLM generation)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (CORS allowed origins, comma-separated)
FRONTEND_URL=http://localhost:5173,https://your-frontend-deployment.vercel.app

# Neon Serverless PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# ChromaDB Cloud Configuration (Optional: defaults to local ChromaDB if omitted)
CHROMA_API_KEY=your_chroma_cloud_api_key
CHROMA_TENANT=your_chroma_tenant_id
CHROMA_DATABASE=osproject
CHROMA_COLLECTION=odpdf

# Google OAuth 2.0 Client ID (For frontend token verification)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
