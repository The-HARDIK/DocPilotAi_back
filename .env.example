# DocPilot AI - Backend Environment Variables

# Required: Groq API Key for LLM inference (get one at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google OAuth Client ID for authentication
GOOGLE_CLIENT_ID=247202504530-chsa46107gb9ii7l9aob0spg945fg6pq.apps.googleusercontent.com

# Optional: Frontend URL for production CORS (e.g., https://your-docpilot-frontend.vercel.app)
FRONTEND_URL=http://localhost:5173

# Optional: Server Port (defaults to 8000 locally, dynamically set by Render/Railway in production)
PORT=8000
